# Copy to .env and fill in. NEXT_PUBLIC_* values are built into the client bundle at build time,
# so redeploy after changing them.

# ─── Auth and billing (Clerk: https://dashboard.clerk.com) ───────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Database (Postgres, e.g. Supabase) ──────────────────────────────────────────────────────────
# Transaction-mode pooler, used by the app.
DATABASE_URL=
# Session-mode pooler or direct connection, used by `prisma migrate`.
DIRECT_URL=

# ─── Realtime doc collaboration (Supabase Realtime + Yjs) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── AI agent (Google Gemini via the Vercel AI SDK) ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model (default gemini-3.5-flash).
# AGENT_MODEL=

# ─── Canvas (tldraw) ─────────────────────────────────────────────────────────────────────────────
# Required in production (any non-localhost domain): https://tldraw.dev/pricing
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
# Your tldraw sync server (a Cloudflare Worker). Leave unset to use tldraw's public demo server,
# where rooms are public and wiped after about a day (the canvas is re-seeded from Postgres).
# NEXT_PUBLIC_TLDRAW_SYNC_URL=
